# Written into site/ by every build (props/htaccess). For the Apache host the site is uploaded to.

# Send the pages compressed: a 1.2 MB board goes over the wire as about 0.25 MB.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>

# The pages and player files change every publish: have browsers check for a new copy rather than show a stale one.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# The book icons and the board's script and styles carry a hash of their contents in their names
# (img/draftkings.1a2b3c4d.png, assets/board.1a2b3c4d.js): a change is a new name, so browsers keep them a year.
<IfModule mod_headers.c>
  <FilesMatch "\.[0-9a-f]{8}\.(png|webp|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
